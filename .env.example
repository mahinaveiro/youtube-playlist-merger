# Backend Configuration

# Port (default: 8080 for OpenShift)
PORT=8080

# bgutil Provider URL (optional - for bot detection bypass)
# Example: http://bgutil-provider:4416
BGUTIL_PROVIDER_URL=

# Allowed CORS Origins (comma-separated)
# Leave empty to allow all origins (development)
# Set specific origins for production
# Example: https://your-app.vercel.app,https://your-domain.com
ALLOWED_ORIGINS=

# Cookies Path (optional - defaults to ./cookies.txt)
# COOKIES_PATH=/custom/path/cookies.txt
